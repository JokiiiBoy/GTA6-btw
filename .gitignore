# ---- never commit the game or anything made from it ----
# (archives, executables, carved files, shaders, textures, models, audio, reports that quote game data)
reports/
work/
/assets/*
!/assets/logo.png
carve/
*.rpf
*.ttpf
*.xvd
*.msixvc
*.dxbc
*.fssm
*.spv
*.spvasm
*.dds
*.bk2
*.awc
*.r9modeldata
*.obj
*.glb
*.ogg
*.wav

# ---- build output and caches ----
build/
build-*/
bin/
# ...but not Cargo binary targets (victory-play.rs, victory-warm.rs)
!**/src/bin/
obj/
__pycache__/
*.pyc
*.exe
*.dll
*.pdb
*.ilk
*.lib
*.exp
*.log
.vs/

# Local Leonida/GTA6-btw artifacts
runtime/build/
leonida-wine-logs/
*.log

# vkd3d-proton pipeline caches (kept in ~/.cache/victory/vkd3d by the run script)
vkd3d-proton.cache
vkd3d-proton.cache.write
